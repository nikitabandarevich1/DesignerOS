# Webpage Page Creation & Modification

## Purpose

Guide creation and modification of pages in `webpage/app/[locale]/`. Covers routing,
layout selection, metadata, ISR, data fetching, i18n, and the server/client split.

---

## Route Groups

| Route Group | Chrome Provided | When to Use |
|---|---|---|
| `(full-layout)` | TopMenu + Footer + Chat | Standard marketing pages |
| `(demo)` | None | Demo request flows |
| `(split-intention)` | Minimal | Discovery/qualification pages |
| Direct under `[locale]/` | None | Campaigns, custom landing pages |

---

## Standard Procedure

### Step 1: Choose the Route Group

Based on layout chrome needed (see table above).

### Step 2: `page.tsx` (Server Component)

```tsx
import type { Metadata } from 'next'
import type { AppPageProps } from 'app/[locale]/types/pageProps'
import { findTldByLocale } from 'lib/findTld'
import { commonPageProps } from 'lib/pagesConfig/cms/dynamicComponentProps'
import { getMetadata } from 'app/[locale]/lib/getMetadata'
import { getImperativeIntl } from 'lib/getImperativeIntl'
import { notFound } from 'next/navigation'
import YourContent from './components/YourContent'

export const revalidate = 1800

export async function generateMetadata(props: AppPageProps): Promise<Metadata> {
  const { locale } = await props.params
  const tld = findTldByLocale(locale)
  if (!tld) notFound()
  const intl = getImperativeIntl(tld)
  return getMetadata({
    tld,
    metaObject: {
      title: intl.formatMessage({ defaultMessage: 'Your Page Title' }),
      description: intl.formatMessage({ defaultMessage: 'Your page description.' })
    }
  })
}

export default async function YourPage(props: AppPageProps) {
  const params = await props.params
  const { locale } = params
  const tld = findTldByLocale(locale)
  if (!tld) notFound()
  return <YourContent {...commonPageProps(locale)} />
}
```

### Step 3: Client Component

```tsx
'use client'
import { useFactorialContext } from 'lib/factorialContext'
import { useIntl } from 'react-intl'
import PageBox from 'design-system/atoms/PageBox'

const YourContent = ({ locale }: { locale: string }) => {
  const { isoCountryCode } = useFactorialContext()
  const intl = useIntl()
  return (
    <main>
      <PageBox>
        <h1>{intl.formatMessage({ defaultMessage: 'Your page heading' })}</h1>
      </PageBox>
    </main>
  )
}
export default YourContent
```

### Step 4: Layout (If Outside `(full-layout)`)

```tsx
import { getDatoTopMenuFooter } from 'lib/api/cms'
import Layout from 'components/layout'

const layoutData = await getDatoTopMenuFooter(tld.datoLocale, false, host)
return (
  <Layout {...commonLayoutProps(layoutData, locale)}>
    <YourContent {...commonPageProps(locale)} />
  </Layout>
)
```

### Step 5: Localized URL Rewrites (If Needed)

Add entries to `webpage/rewrites.js` for localized slugs (e.g. `/solicitar-demo` for Spanish).


## Patterns

### Scroll reveal (stagger list)

```tsx
useEffect(() => {
  const items = gsap.utils.toArray<HTMLElement>('.list-item')
  
  ScrollTrigger.batch(items, {
    onEnter: (batch) =>
      gsap.from(batch, {
        opacity: 0,
        y: 30,
        duration: 0.6,
        stagger: 0.08,
        ease: 'power2.out',
      }),
    start: 'top 85%',
  })

  return () => ScrollTrigger.getAll().forEach((t) => t.kill())
}, [])
```

### Pinned section with scrubbed content

```tsx
useEffect(() => {
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: '.pinned-section',
      pin: true,
      start: 'top top',
      end: '+=1200',
      scrub: 0.5,
    },
  })

  tl.from('.headline', { opacity: 0, y: 40 })
    .from('.subtext', { opacity: 0, y: 20 }, '-=0.3')
    .to('.card', { x: -200, opacity: 0 }, '+=0.2')

  return () => tl.scrollTrigger?.kill()
}, [])
```

### Fake horizontal scroll (containerAnimation)

```tsx
useEffect(() => {
  const container = containerRef.current
  const sections = sectionsRef.current

  const totalWidth = sections.scrollWidth - window.innerWidth

  // Horizontal tween — MUST use ease: 'none'
  const tween = gsap.to(sections, {
    x: -totalWidth,
    ease: 'none',  // REQUIRED with containerAnimation
    duration: 1,
  })

  ScrollTrigger.create({
    trigger: container,
    pin: true,
    start: 'top top',
    end: `+=${totalWidth}`,
    scrub: 1,
    animation: tween,
  })

  // Any nested ScrollTriggers use containerAnimation
  gsap.from('.horizontal-card', {
    opacity: 0,
    scrollTrigger: {
      trigger: '.horizontal-card',
      containerAnimation: tween,  // parent scroll context
      start: 'left 80%',
      toggleActions: 'play none none reverse',
    },
  })

  return () => ScrollTrigger.getAll().forEach((t) => t.kill())
}, [])
```

### Parallax layers

```tsx
useEffect(() => {
  // background slower, foreground faster
  gsap.to('.bg-layer', {
    y: -60,  // moves less (0.2x scroll speed feel)
    ease: 'none',
    scrollTrigger: {
      trigger: '.section',
      start: 'top bottom',
      end: 'bottom top',
      scrub: true,
    },
  })

  gsap.to('.fg-layer', {
    y: -180,  // moves more (0.6x scroll speed feel)
    ease: 'none',
    scrollTrigger: {
      trigger: '.section',
      start: 'top bottom',
      end: 'bottom top',
      scrub: true,
    },
  })

  return () => ScrollTrigger.getAll().forEach((t) => t.kill())
}, [])
```

